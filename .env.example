OCA_APP_NAME=Ontology Curation Assistant

# Local default:
OCA_DATABASE_URL=sqlite:///./oca.sqlite3
# Docker compose overrides this to sqlite:////data/oca.sqlite3.

OCA_ODK_HOME=/odk
OCA_ONTOLOGY_REPO=/odk/ontology
OCA_LOCAL_ONTOLOGY_PATH=ontology
OCA_PPO_ODK_ONTOLOGY_PATH=/odk/ontology/src/ontology
OCA_TEMPLATE_DIR=src/ontology/templates
OCA_DEFAULT_TEMPLATE_FILE=ai_approved_terms.tsv
OCA_GIT_BRANCH_PREFIX=ai-curation/
OCA_REQUIRE_HUMAN_APPROVAL=true

# LLM configuration. Prefer OCA_LLM_API_KEY_ENV_VAR plus a provider-specific
# environment variable in Docker, for example GEMINI_API_KEY.
OCA_LLM_PROVIDER=gemini
OCA_LLM_MODEL=gemini-2.5-flash
OCA_LLM_API_KEY=
OCA_LLM_API_KEY_ENV_VAR=GEMINI_API_KEY
GEMINI_API_KEY=
OCA_LLM_BASE_URL=
OCA_LLM_TEMPERATURE=0
OCA_LLM_MAX_OUTPUT_TOKENS=1024
OCA_LLM_TIMEOUT_SECONDS=30
OCA_LLM_RETRY_COUNT=1
OCA_LLM_STREAM=false
OCA_LLM_CONTEXT_CHAR_LIMIT=200000

OCA_ZOTERO_LIBRARY_TYPE=
OCA_ZOTERO_LIBRARY_ID=
OCA_ZOTERO_API_KEY=
OCA_ZOTERO_COLLECTION_KEY=
OCA_ZOTERO_API_BASE_URL=https://api.zotero.org
OCA_ZOTERO_LITERATURE_STORAGE_PATH=
OCA_ZOTERO_LINKED_ATTACHMENT_BASE_DIR=

OCA_LITERATURE_BASE_DIR=literature
OCA_LITERATURE_PDF_DIR=literature/Paper-PDF
OCA_LITERATURE_GENERATED_MD_DIR=literature/Markdown
OCA_LITERATURE_REPOSITORY_PATH=literature/papers
OCA_LITERATURE_COMBINED_OUTPUT_FILE=literature/combined_literature.md
OCA_LITERATURE_FUZZY_MIN_SCORE=0.82

# Optional publisher enrichment. ELSEVIER_API_KEY / ELSEVIER_INSTTOKEN also work
# and take precedence over values saved through the browser Settings page.
ELSEVIER_API_KEY=
ELSEVIER_INSTTOKEN=
OCA_ELSEVIER_API_BASE_URL=https://api.elsevier.com
OCA_PUBLISHER_API_ENRICHMENT_ENABLED=false

OCA_ODK_TEMPLATE_RELATIVE_PATH=templates/ai_approved_terms.tsv
OCA_ODK_VALIDATION_COMMAND=make test
OCA_ODK_WORKFLOW_DRY_RUN=true
OCA_ODK_UPLOAD_MODE=github
OCA_ODK_AUDIT_LOG_PATH=logs/odk_workflow_audit.jsonl

GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_BRANCH=main
GITHUB_BASE_PATH=
